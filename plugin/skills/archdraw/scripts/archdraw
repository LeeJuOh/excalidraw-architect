#!/bin/sh
# Generated by scripts/generate-manifests.mjs — run `npm run manifests` after a
# version bump; the pinned version below comes from package.json.
#
# No arguments  -> MCP stdio server (how both MCP manifests launch it)
# <command> ... -> CLI fallback, called as `scripts/archdraw <command>` from the
#                  skill root by hosts that did not register the MCP server.
#
# ARCHDRAW_BIN=<repo>/dist/bin.js runs a local build instead of the published
# package, on both paths (ADR-0002). Note the host process must inherit it, so
# start claude/codex from a shell that has it.
set -e

if [ -n "${ARCHDRAW_BIN:-}" ]; then
  exec node "$ARCHDRAW_BIN" "$@"
fi

exec npx -y excalidraw-architect@0.1.0 "$@"
