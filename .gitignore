# Dependencies
node_modules/

# Build artifacts
dist/
public/dist/

# Environment files
.env

# Logs
*.log

# Editor artifacts
.idea/
*.iml
.cursor/
.agent/
# .claude/ and .agents/ are ignored except the shared permission allowlist and
# the Codex marketplace catalog. git cannot re-include a file inside an
# excluded directory, so exclude contents (`/*`) rather than the directory.
.claude/*
!.claude/settings.json
.agents/*
!.agents/plugins/
.agents/plugins/*
!.agents/plugins/marketplace.json

# Development artifacts
*.excalidraw

.DS_Store


# Browser regression artifacts
test-results/
playwright-report/

# Throwaway trees from scripts/check-mcp-stdio.mjs
.mcp-stdio-check-*/
